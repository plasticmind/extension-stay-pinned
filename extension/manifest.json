{
  "manifest_version": 3,
  "name": "Stay Pinned",
  "version": "1.0.0",
  "description": "Opens your pinned tabs in every new window and resets them with a keyboard shortcut.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "storage", "favicon"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Stay Pinned",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "reset-window": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Reset pinned tabs in this window"
    },
    "reset-tab": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Reset the current pinned tab"
    }
  }
}
